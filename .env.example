REFLOW_ADDR=127.0.0.1:7381
REFLOW_DATA_DIR=
REFLOW_DB_PATH=
REFLOW_MASTER_KEY_PATH=
REFLOW_WEB_DIR=web/dist
REFLOW_TLS_CERT_PATH=
REFLOW_TLS_KEY_PATH=
REFLOW_LOG_LEVEL=info
REFLOW_LAN_MODE=false
REFLOW_RSSHUB_BASE=https://rsshub.app
REFLOW_ALLOWED_ORIGINS=
REFLOW_TRUSTED_PROXIES=

# Vite dev-server proxy target and port (used by `pnpm dev`).
REFLOW_DEV_API=http://127.0.0.1:7381
REFLOW_DEV_PORT=4173

# Dida365 task sync used by the workbench buttons and `reflow sync dida`.
REFLOW_DIDA_PROJECT=Reflow
REFLOW_DIDA_COMMAND=dida
# Optional mapping file override. Empty uses the per-user default.
REFLOW_DIDA_STATE=
